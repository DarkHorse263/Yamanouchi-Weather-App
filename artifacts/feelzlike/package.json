{
  "name": "@workspace/feelzlike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "node scripts/generate-sitemap.mjs && SENTRY_RELEASE=$(git rev-parse --short HEAD 2>/dev/null || date -u +nogit-%Y%m%dT%H%M%SZ) vite build --config vite.config.ts && node scripts/prerender.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "data:smoke": "tsx scripts/curated-smoke.mts",
    "test:affiliate": "tsx src/lib/__tests__/affiliateLinks.test.ts",
    "test:openNow": "tsx src/lib/__tests__/openNow.test.ts",
    "test:reservation": "tsx src/lib/__tests__/reservationLinks.test.ts",
    "test:score": "tsx --test src/lib/__tests__/mountainScore.test.ts",
    "test:windHold": "tsx --test src/lib/__tests__/windHoldPrediction.test.ts",
    "test:powderFactor": "tsx --test src/lib/__tests__/powderFactor.test.ts",
    "test:tripPlanner": "tsx --test src/lib/__tests__/tripPlanner.test.ts",
    "test:regionProximity": "tsx --test src/lib/__tests__/regionProximity.test.ts",
    "test:nearYouRegionRow": "tsx --tsconfig tsconfig.test.json --test src/components/home/__tests__/NearYouRegionRow.test.tsx",
    "test:skiSeason": "tsx --test src/lib/__tests__/skiSeason.test.ts",
    "test:cj": "tsx --test src/lib/__tests__/cj.test.ts",
    "test:all": "tsx --test src/lib/__tests__/mountainScore.test.ts src/lib/__tests__/windHoldPrediction.test.ts src/lib/__tests__/powderFactor.test.ts src/lib/__tests__/tripPlanner.test.ts src/lib/__tests__/regionProximity.test.ts src/lib/__tests__/skiSeason.test.ts src/lib/__tests__/cj.test.ts && tsx --tsconfig tsconfig.test.json --test src/components/home/__tests__/NearYouRegionRow.test.tsx"
  },
