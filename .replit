modules = ["nodejs-24", "python-3.11", "postgresql-16"]

  [[artifacts]]
  id = "artifacts/api-server"

  [[artifacts]]
  id = "artifacts/mockup-sandbox"

  [deployment]
  router = "application"
  deploymentTarget = "autoscale"
  build = ["bash", "-c", "BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/feelzlike run build && pnpm --filter @workspace/api-server run build"]
  run = ["bash", "-c", "NODE_ENV=production PORT=80 node artifacts/api-server/dist/index.cjs"]

  [deployment.postBuild]
  args = ["pnpm", "store", "prune"]
  env = { "CI" = "true" }

  [workflows]
runButton = "Project"

  [agent]
  stack = "PNPM_WORKSPACE"
expertMode = true

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 20000

  [nix]
  channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.shared]
VITE_VAPID_PUBLIC_KEY = "BCoXjQ2TUG8JM_ehyoZl5WLZLUgdQeaqzUVpohrgK0xoKPbFibCQhze5y3tHgV5rQTPOi8t961qEdM6g842h_zY"
ADMIN_EMAILS = "james@navigatework.com.au"
VITE_PLAUSIBLE_DOMAIN = "feelzlike.com"
VITE_AWIN_PUBLISHER_ID = "2813742"
VITE_CJ_PUBLISHER_ID = "101761193"
ALERT_FROM_EMAIL = "feelzlike <info@feelzlike.com>"

[userenv.development]
ALLOW_UNAUTH_CRON = "1"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 23968
externalPort = 3000
  